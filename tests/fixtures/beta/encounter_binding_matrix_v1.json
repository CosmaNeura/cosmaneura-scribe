{
  "schema_version": "1.0",
  "ownership": {
    "human_identity": "core_existing_clerk",
    "demographics_and_matching": "core",
    "canonical_encounter": "core",
    "recording_and_transcript": "scribe",
    "recording_visibility": "immutable_creator_only"
  },
  "scribe_boundary": {
    "tenant_source": "verified_entra_context",
    "creator_source": "core_authenticated_actor",
    "allowed_request_fields": [
      "appointment_id",
      "practitioner_id",
      "patient_id",
      "consent_record_id",
      "modality"
    ],
    "forbidden_request_fields": [
      "tenant_id",
      "creator_actor_id",
      "patient_name",
      "patient_date_of_birth",
      "possible_matches"
    ]
  },
  "rules": {
    "binding_precedes_capture": true,
    "consent_precedes_audio_processing": true,
    "manual_demographics_are_synthetic_only_in_closed_beta": true,
    "possible_matches_never_auto_merge": true,
    "explicit_resolution_required_when_matches_exist": true,
    "mutation_idempotency_required": true,
    "successful_binding_appears_in_creator_dashboard": true
  },
  "cases": [
    {
      "case_id": "existing_appointment_authorized",
      "authenticated": true,
      "session_revoked": false,
      "beta_grant": "active",
      "practice_relation": "same",
      "view_as": false,
      "mode": "existing_appointment",
      "appointment_authorized": true,
      "manual_name_present": null,
      "manual_dob_present": null,
      "possible_match_count": null,
      "explicit_resolution": "use_existing_appointment",
      "selected_match_authorized": true,
      "idempotency": "first",
      "expected": {
        "action": "bind_existing_appointment",
        "create_scribe_session": true,
        "capture_start_allowed": true,
        "dashboard_visible_to_creator": true,
        "duplicate_encounter_created": false
      }
    },
    {
      "case_id": "existing_appointment_unauthorized",
      "authenticated": true,
