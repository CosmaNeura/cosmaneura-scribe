subscription_id       = "00000000-0000-0000-0000-000000000000"
tenant_id             = "00000000-0000-0000-0000-000000000000"
environment           = "production"
location              = "eastus"
resource_group_name   = "cosmaneura-scribe-production"
create_resource_group = true

# These names were available on 2026-08-14 but remain unreserved until a reviewed apply.
storage_account_name     = "cosmaneurascribeprod"
key_vault_name           = "cosmaneura-scribe-prod"
container_registry_name = "cosmaneurascribeprod"

# Production cost/retention approval is separate. Keep the staged workspace and diagnostics off.
enable_development_cost_guardrails     = false
enable_log_analytics_audit_baseline    = false
enable_phi_safe_data_plane_diagnostics = false
log_analytics_retention_in_days         = 30
log_analytics_daily_quota_gb            = 0.5

# Production is isolated from the live 10.42.0.0/16 Scribe development,
# 10.44.0.0/16 scheduling development, and 10.45.0.0/16 scheduling PostgreSQL boundaries.
virtual_network_address_space            = ["10.46.0.0/16"]
private_endpoint_subnet_address_prefixes = ["10.46.1.0/24"]
container_apps_subnet_address_prefixes   = ["10.46.2.0/23"]
postgres_subnet_address_prefixes         = ["10.46.4.0/24"]
production_native_edge_subnet_address_prefixes = ["10.46.6.0/23"]

# Foundation-only review. East US PostgreSQL capacity is still pending and no workload is approved.
deploy_container_app              = false
deploy_postgres_foundation        = false
deploy_database_migration_job     = false
deploy_private_speech_foundation  = false
deploy_speech_smoke_job           = false
enable_speech_smoke_job           = false
deploy_transcription_job          = false
enable_transcription_job          = false
deploy_delivery_reconciler_job    = false
enable_delivery_reconciler_job    = false
deploy_private_terraform_runner   = false
enable_private_terraform_runner   = false
deploy_private_api_acceptance_job       = false
enable_private_api_acceptance_job       = false
allow_private_api_acceptance_invocation = false
private_terraform_reconciliation_completed = false
use_postgres_repository           = false
container_image_repository        = "cosmaneura-scribe-api"
container_image_tag               = "not-deployed"
container_image_digest            = "not-deployed"
postgres_server_name              = "cosmaneura-scribe-prod-pg"
postgres_database_name            = "cosmaneura_scribe"

# Workload features remain off until Entra roles, durable storage, and synthetic validation pass.
enable_master_platform_handoff = false
master_platform_base_url       = "https://app.example.invalid"
master_platform_scope          = "api://00000000-0000-0000-0000-000000000000/.default"

enable_workflow_authentication = false
workflow_api_audience          = "00000000-0000-0000-0000-000000000000"
trusted_platform_client_id     = "00000000-0000-0000-0000-000000000000"
enable_capture_protocol        = false

# Native production edge: all controls remain false. The image, existing identity,
# Core registry database, receipt hashes, and exact binding are founder-supplied
# only after their separate review. Never place credentials or patient data here.
deploy_production_native_edge              = false
enable_production_native_direct_upload     = false
enable_production_native_receiver          = false
enable_production_native_encounter_creation = false
production_native_receiver_image_repository = "cosmaneura-scribe-native-receiver"
production_native_receiver_image_tag        = "not-deployed"
production_native_receiver_image_digest     = "not-deployed"
production_native_receiver_image_contract_sha256 = ""
production_native_receiver_identity_resource_id   = ""
production_native_receiver_identity_client_id     = ""
production_core_registry_postgres_resource_id     = ""
production_native_upload_policy_receipt_sha256    = ""
production_native_receiver_binding                = null

connect_parallel_platform_vnet = false
parallel_platform_vnet_id      = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/cosmaneura-prod/providers/Microsoft.Network/virtualNetworks/cosmaneura-prod-parallel-vnet"
