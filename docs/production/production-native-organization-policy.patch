+def production_core_personal_configuration_valid(settings: Settings) -> bool:
+    """Separate production native profile; no change to generic OS settings."""
+    return bool(
+        settings.clerk_issuer == "https://clerk.cosmaneura.com"
+        and settings.clerk_organization_id is None
+        and (settings.clerk_audience is None
+             or re.fullmatch(r"[!-~]{1,255}", settings.clerk_audience))
+        and all(error == "Authenticated workspace requires a Clerk organization and audience"
+                for error in settings.workspace_authentication_errors())
+    )
+
