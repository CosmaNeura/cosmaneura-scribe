+  static func authStorageOwnerIdentifier(
+    ownerIdentifier: String?, options: Clerk.Options, frontendApiUrl: String, publishableKey: String
+  ) -> String? {
+    let owner = ownerIdentifier?.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard options.authStorageNamespace == .productionInstanceV1, let owner, !owner.isEmpty else {
+      return owner
+    }
+    let fingerprint = SharedSessionNamespace(
+      frontendApiUrl: frontendApiUrl, publishableKey: publishableKey
+    ).fingerprint
+    return owner + ".production-instance.v1." + fingerprint
+  }
