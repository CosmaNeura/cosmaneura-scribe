{
  "name": "@cosmaneura-scribe/capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": "11.5.2"
  },
  "packageManager": "npm@11.5.2",
  "scripts": {
    "build": "vite build",
    "build:provider": "vite build --config provider.vite.config.ts",
    "check:preview-bundle": "node scripts/check-preview-bundle.mjs",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios --packagemanager SPM",
    "cap:sync": "cap sync",
    "cap:sync:android": "cap sync android",
    "cap:sync:ios": "cap sync ios",
    "check:api": "openapi-typescript ../../openapi/openapi.json -o src/generated/capture-api.ts --check",
    "dev": "vite",
    "generate:api": "openapi-typescript ../../openapi/openapi.json -o src/generated/capture-api.ts",
    "lint": "eslint . --max-warnings 0",
    "mock:bff": "tsx src/mock-bff/server.ts",
    "test": "npm run test:apple-release-metadata && vitest run",
    "test:apple-release-metadata": "node --test scripts/check-apple-release-metadata.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@cosmaneura-scribe/capacitor-secure-queue": "0.1.0",
    "@cosmaneura-scribe/capture-preview-domain": "0.1.0",
    "@cosmaneura-scribe/capture-protocol": "1.0.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "fake-indexeddb": "6.2.5"
  }
}
