{
  "schemaVersion": 1,
  "application": {
    "bundleIdentifier": "com.cosmaneura.desktop-companion",
    "productName": "Cosmas Desktop Companion",
    "main": "dist/main-entry.js",
    "protocol": "cosmaneura-capture"
  },
  "release": {
    "packagingEnabled": false,
    "captureEnabled": false,
    "clinicalReleaseApproved": false,
    "unsignedDistributionAllowed": false
  },
  "archive": {
    "asarRequired": true,
    "embeddedIntegrityRequired": true
  },
  "diagnostics": {
    "analyticsEnabled": false,
    "chromiumLoggingEnabled": false,
    "electronCrashReporterStarted": false,
    "localElectronCrashDumpsAllowed": false,
    "nodeDiagnosticReportsEnabled": false,
    "remoteDebuggingEnabled": false,
    "supportBundlesEnabled": false
  },
  "fuses": {
    "runAsNode": false,
    "cookieEncryption": true,
    "nodeOptionsEnvironmentVariable": false,
    "nodeCliInspectArguments": false,
    "embeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "browserProcessSpecificV8Snapshot": true,
    "fileProtocolExtraPrivileges": false
  },
  "targets": {
    "darwin-arm64": {
      "signatureRequired": true,
      "notarizationRequired": true,
      "stapleRequired": true,
      "hardenedRuntimeRequired": true,
      "secureTimestampRequired": true,
      "debugEntitlementDenied": true,
      "expectedTeamIdentifier": "UNCONFIGURED",
      "credentialSource": "temporary-ci-keychain"
    },
    "win32-x64": {
      "signatureRequired": true,
      "timestampRequired": true,
      "expectedPublisherSubject": "UNCONFIGURED",
      "credentialSource": "github-oidc-azure-artifact-signing"
    }
  }
}
