{
  "name": "@cosmaneura-scribe/desktop-companion",
  "version": "0.0.0",
  "private": true,
  "productName": "Cosmas Desktop Companion",
  "description": "Hard-disabled CosmaNeura desktop capture companion",
  "author": "CosmaNeura",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": "11.5.2"
  },
  "packageManager": "npm@11.5.2",
  "main": "dist/main-entry.js",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release:policy:verify": "node scripts/verify-desktop-package-policy.mjs",
    "release:sbom": "node scripts/generate-desktop-sbom.mjs",
    "release:assemble": "node scripts/assemble-electron-package.mjs",
    "release:artifacts:verify": "node scripts/verify-signed-desktop-artifacts.mjs",
    "release:harden": "node scripts/harden-electron-package.mjs",
    "release:sign-notarize:macos": "node scripts/sign-notarize-macos-package.mjs",
    "vendor:recall:prepare": "node scripts/prepare-recall-sdk.mjs",
    "vendor:recall:accept:macos": "npm run build && vendor-runtime/node_modules/.bin/electron scripts/run-recall-macos-acceptance.mjs",
    "vendor:recall:verify-prepared": "npm run build && node dist/verify-recall-runtime-entry.js",
    "vendor:recall:verify-source": "node scripts/prepare-recall-sdk.mjs --verify-source"
  }
}
