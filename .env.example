# Non-secret local configuration only. Authenticate to Azure with `az login`.
COSMANEURA_SCRIBE_STORAGE_BACKEND=memory
COSMANEURA_SCRIBE_STORAGE_ACCOUNT_URL=https://replace-me.blob.core.windows.net
COSMANEURA_SCRIBE_STORAGE_CONTAINER_NAME=audio
COSMANEURA_SCRIBE_UPLOAD_GRANT_TTL_SECONDS=900
COSMANEURA_SCRIBE_REPOSITORY_BACKEND=memory
# Set this non-secret client ID only in Azure when a user-assigned identity is attached.
# COSMANEURA_SCRIBE_MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000
# The API publishes only this versionless Azure Key Vault key's current public material.
# The inactive worker uses the same configured key name for version-bound unwrap operations.
# COSMANEURA_SCRIBE_AUDIO_ENCRYPTION_KEY_ID=https://<vault>.vault.azure.net/keys/<key-name>
# COSMANEURA_SCRIBE_AUDIO_ASSEMBLY_ENCRYPTED_TEMP_DIRECTORY=/var/lib/cosmaneura-scribe/audio-assembly
# COSMANEURA_SCRIBE_AUDIO_ASSEMBLY_MAX_PLAINTEXT_BYTES=67108864

# Workflow routes fail closed unless Entra app-only authentication is explicitly configured.
# Keep disabled for local work; tests override the verified tenant dependency.
COSMANEURA_SCRIBE_WORKFLOW_AUTHENTICATION_ENABLED=false
# COSMANEURA_SCRIBE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# COSMANEURA_SCRIBE_WORKFLOW_API_AUDIENCE=00000000-0000-0000-0000-000000000000
# COSMANEURA_SCRIBE_TRUSTED_PLATFORM_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Azure PostgreSQL uses the attached managed identity and an Entra token, not a password.
# COSMANEURA_SCRIBE_REPOSITORY_BACKEND=postgres
# COSMANEURA_SCRIBE_DATABASE_HOST=<server>.postgres.database.azure.com
# COSMANEURA_SCRIBE_DATABASE_NAME=cosmaneura_scribe
# COSMANEURA_SCRIBE_DATABASE_USER=<runtime-managed-identity-name>
# Migration/bootstrap job only: map the dedicated worker identity and grant its narrower role.
# COSMANEURA_SCRIBE_DATABASE_TRANSCRIPTION_PRINCIPAL_NAME=<transcription-identity-name>
# COSMANEURA_SCRIBE_DATABASE_TRANSCRIPTION_PRINCIPAL_OBJECT_ID=00000000-0000-0000-0000-000000000000

# Speech-to-text is disabled until a benchmark or worker explicitly selects a provider.
COSMANEURA_SCRIBE_TRANSCRIPTION_BACKEND=none
# COSMANEURA_SCRIBE_TRANSCRIPTION_BACKEND=azure
# COSMANEURA_SCRIBE_AZURE_SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# JSON array of exact private-endpoint IP CIDRs supplied by the owned Terraform foundation.
# COSMANEURA_SCRIBE_AZURE_SPEECH_PRIVATE_ENDPOINT_CIDRS=["10.42.1.4/32"]
# COSMANEURA_SCRIBE_AZURE_SPEECH_MAX_SPEAKERS=4

# The manual synthetic acceptance job hard-gates before Settings, fixture reads, DNS, or clients.
COSMANEURA_SCRIBE_SPEECH_SMOKE_ENABLED=false

# The manual ACA job hard-gates before Settings, positional UUID parsing, or Azure client creation.
# Tenant and session UUIDs are exactly two per-execution command arguments, never environment vars.
COSMANEURA_SCRIBE_TRANSCRIPTION_JOB_ENABLED=false
# COSMANEURA_SCRIBE_TRANSCRIPTION_JOB_LANGUAGE_CODE=en-US

# Restrict DefaultAzureCredential to developer credentials locally.
AZURE_TOKEN_CREDENTIALS=dev
