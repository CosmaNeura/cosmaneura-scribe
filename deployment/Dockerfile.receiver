# syntax=docker/dockerfile:1

# The context preparer records and validates both digest-pinned references.
# There are intentionally no mutable defaults: an omitted build argument fails
# before a layer can run.
ARG UV_BUILDER_IMAGE
ARG PYTHON_RUNTIME_IMAGE
FROM ${UV_BUILDER_IMAGE} AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY services/api ./services/api

RUN uv sync --locked --no-editable --no-dev

FROM ${PYTHON_RUNTIME_IMAGE} AS runtime

ARG SOURCE_REVISION

RUN test "${#SOURCE_REVISION}" -eq 40 \
    && case "${SOURCE_REVISION}" in *[!0-9a-f]*) exit 1 ;; *) exit 0 ;; esac

LABEL org.opencontainers.image.title="Cosmaneura Scribe standalone receiver" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/CosmaNeura/cosmaneura-scribe"

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv

COPY receiver ./provider
COPY identity-source ./provider/identity-source
COPY --chmod=0444 identity-source-manifest.json ./provider/identity-source-manifest.json
COPY --chmod=0444 receiver-image-manifest.json ./provider/receiver-image-manifest.json

RUN mkdir /app/provider-config \
    && chown 10001:10001 /app/provider-config \
    && chmod 0700 /app/provider-config

ENV PYTHONPATH="/app/provider/identity-source:/app/provider"

USER 10001:10001

EXPOSE 8080

CMD ["python", "/app/provider/image_entrypoint.py"]
